<view class="page">
  <view class="heading">连接与数据管理</view><view class="muted">{{notice}}</view>
  <view class="card"><view class="card-title">设备连接 {{connected ? '· 已配置' : '· 离线'}}</view><input class="input" value="{{link}}" bindinput="editLink" placeholder="电脑启动窗口中的 HTTP/HTTPS 地址" /><input class="input" value="{{token}}" bindinput="editToken" password placeholder="扫码链接中的一次性授权码" /><view class="row"><button class="button button-yellow" bindtap="connect">保存连接并同步</button><button class="button button-light" bindtap="disconnect">断开</button></view><button class="button button-light" bindtap="syncNow" loading="{{syncing}}">现在同步</button></view>
  <view class="card"><view class="card-title">随身题包 · 当前 {{packPreview.count || 0}} 题</view><button class="button button-light" bindtap="selectDocument">选择学习包 JSON</button><view wx:if="{{packPreview}}"><text>{{packPreview.title}} · {{packPreview.bytes}} 字节 · {{packPreview.version.slice(0,12)}}</text><button class="button button-yellow" bindtap="importPack">确认下载并安装</button></view><button class="button button-light" bindtap="clearAssets">清理图片缓存</button></view>
  <view class="card"><view class="card-title">个人学习备份</view><button class="button button-light" bindtap="exportBackup">下载备份文件</button><button class="button button-light" bindtap="chooseBackup">选择并检查备份</button><view wx:if="{{pendingBackup}}"><text>{{backupCount}} 条记录 · 当前数据不会覆盖</text><button class="button button-yellow" bindtap="importBackup">确认合并</button></view></view>
  <view class="card"><view class="card-title">搜索题库 · {{total}} 条结果</view><input class="input" value="{{query}}" bindinput="setQuery" confirm-type="search" bindconfirm="search" placeholder="输入题号或题干关键词"/><picker range="{{subjects}}" bindchange="setSubject"><view class="chip">{{subjects[0]}}</view></picker><picker range="{{years}}" bindchange="setYear"><view class="chip">年份：{{year || '全部 / 未标注'}}</view></picker><view class="sheet-filters"><button data-kind="all" bindtap="setKind">题库</button><button data-kind="favorites" bindtap="setKind">收藏</button><button data-kind="notes" bindtap="setKind">笔记</button><button data-kind="wrong" bindtap="setKind">错题</button></view><view class="row"><button class="button button-yellow" bindtap="search">搜索</button><button class="button button-light" bindtap="clear">清除筛选</button></view>
    <view wx:for="{{results}}" wx:key="id" class="card"><view bindtap="openQuestion" data-id="{{item.id}}"><b>{{item.id}}</b> · {{item.type}} · {{item.bank}}</view><button data-id="{{item.id}}" bindtap="favorite">{{item.favorite ? '★ 已收藏' : '☆ 收藏'}}</button><textarea maxlength="2000" placeholder="题目笔记" value="{{item.note}}" data-id="{{item.id}}" bindinput="editNote" bindblur="saveNote"/><button data-id="{{item.id}}" bindtap="downloadQuestion">下载题面 / 公式</button></view></view>
  <view wx:if="{{message}}" class="muted" role="status">{{message}}</view>
</view>
