<view class="page"><view wx:if="{{error}}" class="notice muted" role="status">{{error}}<button wx:if="{{pending}}" bindtap="retrySave">重试保存本题</button><button bindtap="returnRecords">答卷记录</button></view><view wx:if="{{!exam}}"><view class="heading">整卷考试记录</view><view wx:for="{{exams}}" wx:key="id" class="card"><b>{{item.title}}</b><view class="muted">{{item.submitted_at ? '已交卷' : '进行中'}}{{item.pending_count ? ' · ' + item.pending_count + ' 题待自评' : ''}}</view><button class="button button-yellow" data-id="{{item.id}}" bindtap="enter">{{item.submitted_at ? '查看 / 自评' : '继续考试'}}</button></view><button class="button button-light" bindtap="returnRecords">刷新记录</button></view><view wx:if="{{exam}}"><view class="exam-top"><view><b>{{exam.paper.title}}</b><text wx:if="{{!exam.submitted_at}}"> · 剩余 {{Math.max(0, Math.ceil((Date.parse(exam.deadline_at)-Date.now())/60000))}} 分钟</text><text wx:else> · 已交卷</text></view><text>{{index+1}} / {{exam.paper.questions.length}}</text><view class="exam-save">{{localSaved ? '已存本机' : '本机保存失败'}} · {{pending ? '待同步 '+pending+' 题' : exam.submitted_at ? '已封卷' : '已存电脑'}}</view></view><button bindtap="toggleSheet">答题卡 · {{answers && Object.keys(answers).length}} 项</button><view wx:if="{{sheetOpen}}" class="sheet-mask" catchtap="toggleSheet"><view class="sheet-panel" catchtap="stopTap"><view class="sheet-grid"><button wx:for="{{exam.paper.questions}}" wx:key="id" data-index="{{index}}" bindtap="changeQuestion">{{index+1}}{{answers[item.id]?.selected_options.length || answers[item.id]?.text_answer ? ' ✓' : ' ○'}}</button></view></view></view><view wx:if="{{question}}" class="card"><view class="muted">{{question.section_title}} · {{question.type}} · {{question.allocated_score}} 分</view><question-content wx:if="{{question.frozen_question_preview}}" question-id="{{question.id}}" kind="question"/><view wx:else user-select="true" class="review-text">{{question.stem_markdown}}</view><view wx:if="{{question.type === 'choice'}}"><button wx:for="{{question.options}}" wx:key="key" class="exam-option {{answers[question.id].selected_options.includes(item.key) ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="choose">{{item.key}} · {{item.text}}</button></view><textarea wx:else class="draft-input" placeholder="自动暂存的主观题草稿" maxlength="20000" value="{{answers[question.id].text_answer}}" bindinput="editText" bindkeyboardheightchange="keyboardChanged"/><button wx:if="{{!exam.submitted_at}}" bindtap="toggleMark">{{answers[question.id].marked ? '★ 已标记' : '☆ 标记此题'}}</button><view wx:if="{{exam.submitted_at}}" class="card"><text>参考解：{{question.answer_markdown}}</text><text>{{question.analysis_markdown}}</text><view wx:if="{{exam.results.questions[question.id].status === 'pending'}}"><input type="digit" value="{{grading}}" placeholder="本题自评得分" bindblur="selfGrade"/><button bindtap="saveGrade">保存自评</button></view></view></view><view class="exam-dock"><button disabled="{{!index}}" bindtap="previous">上一题</button><button wx:if="{{pending && !exam.submitted_at}}" bindtap="retrySave">重试保存</button><button wx:if="{{index+1<exam.paper.questions.length}}" bindtap="next">下一题</button><button wx:else-if="{{!exam.submitted_at}}" class="button-yellow" bindtap="finish">交卷</button></view></view></view>
