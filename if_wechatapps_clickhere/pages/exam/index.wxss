.exam-top{position:sticky;top:0;background:#fff;border:3rpx solid #172332;padding:15rpx;z-index:2}.exam-save{font-size:22rpx;color:#526065}.exam-option{width:100%;min-height:54px;white-space:normal;text-align:left;margin:10rpx 0}.exam-option.selected{background:#ffd54f}.exam-dock{position:fixed;z-index:20;left:0;right:0;bottom:env(safe-area-inset-bottom);display:flex;gap:10rpx;padding:16rpx;background:#fff;border-top:3rpx solid #172332}.exam-dock button{flex:1;min-width:0;min-height:44px}.exam-option{overflow-wrap:anywhere}.exam-top{overflow-wrap:anywhere}.sheet-panel{padding:24rpx;max-height:60vh;overflow:auto}
