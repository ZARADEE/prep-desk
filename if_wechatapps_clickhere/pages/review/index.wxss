.review-text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:30rpx;line-height:1.7;margin:20rpx 0}.grade-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.grade-row button{margin:0;min-height:70px;white-space:normal}.grade-row button text{display:block;font-size:21rpx}.review-text image{width:100%}.draft-input{width:100%;box-sizing:border-box}
