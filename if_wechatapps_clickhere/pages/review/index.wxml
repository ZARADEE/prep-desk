<view class="page"><view class="heading">到期复习</view><view class="muted">{{summary ? '剩余 ' + summary.remaining + ' 项 · 已复习 ' + summary.reviewed + ' 项' : '根据 FSRS 计划安排'}}</view><view wx:if="{{message}}" class="card muted" role="status">{{message}}</view><button wx:if="{{undo}}" class="button button-light" bindtap="undo">撤销最近一次评级</button><view wx:if="{{question}}" class="card"><button bindtap="close">返回队列</button><view class="card-title">{{item.title}} · {{item.new ? '新卡' : '到期复习'}}</view><question-content wx:if="{{questionImage}}" question-id="{{question.id}}" text="{{question.stem_markdown}}"/><text wx:else user-select="true" class="review-text">{{question.stem_markdown}}</text><view wx:for="{{question.options}}" wx:key="key" class="option"><b>{{item.key}}</b><text>{{item.text}}</text></view><textarea class="draft-input" placeholder="先独立回忆，可填写简短过程" value="{{answer}}" bindinput="input" maxlength="30000"/><button wx:if="{{!reveal}}" class="button button-yellow" bindtap="reveal">完成回忆，查看参考解</button><view wx:if="{{reveal}}"><view class="review-text">{{reveal.question.answer_markdown}}</view><view class="review-text">{{reveal.question.analysis_markdown}}</view><view class="grade-row"><button wx:for="{{reveal.previews}}" wx:key="rating" data-rating="{{item.rating}}" disabled="{{busy}}" bindtap="rate">{{['','忘记','困难','良好','轻松'][item.rating]}}<text>{{item.seconds > 86400 ? Math.round(item.seconds/86400)+'天' : Math.max(1,Math.round(item.seconds/60))+'分'}}</text></button></view></view></view><view wx:elif="{{!question}}"><view wx:for="{{items}}" wx:key="id" class="card"><view class="card-title">{{item.title}}</view><view class="muted">{{item.new ? '新卡' : item.overdue ? '已到期' : '稍后到期'}} · {{item.subject}}</view><button class="button button-yellow" disabled="{{!summary.ready || busy}}" data-item="{{item}}" bindtap="open">开始回忆</button></view></view></view>
