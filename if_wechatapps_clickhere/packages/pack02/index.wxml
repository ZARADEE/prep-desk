<view class="page practice-page">
  <view wx:if="{{error}}" class="empty">{{error}}<button class="button" bindtap="backHome">返回首页</button></view>
  <view wx:if="{{question && !done}}">
    <view class="practice-header"><text class="practice-title">{{title}}</text><text class="progress">{{index + 1}} / {{total}}</text></view>
    <view class="progress-track"><view class="progress-fill" style="width:{{progressWidth}}"></view></view>
    <view class="sheet-toggle" hover-class="tap-pressed" hover-stay-time="90" bindtap="toggleSheet">答题卡 · 已完成 {{answeredCount}} / {{total}} <text>{{sheetOpen ? '收起⌃' : '展开⌄'}}</text></view>
    <view class="save-status" bindtap="retrySave">{{saveStatus}}</view>
    <view wx:if="{{sheetOpen}}" class="sheet-mask" catchtap="toggleSheet" catchtouchmove="stopTap">
      <view class="sheet-panel" catchtap="stopTap">
        <view class="row"><text class="heading">答题卡</text><button class="button button-light" bindtap="toggleSheet">关闭 ×</button></view>
        <view class="sheet-filters"><button data-filter="all" bindtap="filterSheet">全部</button><button data-filter="unanswered" bindtap="filterSheet">未答</button><button data-filter="marked" bindtap="filterSheet">标记</button><button data-filter="pending" bindtap="filterSheet">待自评</button></view>
        <scroll-view scroll-y="true" class="sheet-scroll"><view class="sheet-grid">
          <view wx:for="{{visibleSheet}}" wx:key="index" aria-role="button" aria-label="第{{item.number}}题，{{item.current ? '当前位置，' : ''}}{{item.pending ? '待自评' : item.answered ? '已答' : '未答'}}" class="sheet-item {{item.answered ? 'answered' : ''}} {{item.wrong ? 'wrong' : ''}} {{item.pending ? 'pending' : ''}} {{item.current ? 'current' : ''}}" hover-class="tap-pressed" data-index="{{item.index}}" bindtap="openQuestion"><text>{{item.number}}{{item.marked ? '★' : ''}}</text><text class="sheet-symbol">{{item.pending ? '待评' : item.answered ? item.wrong ? '×' : '✓' : '○'}}</text></view>
        </view></scroll-view>
        <view class="muted">✓ 正确 · × 错题 · ○ 未答 · 粗边框为当前题</view>
      </view>
    </view>
    <view class="question-meta">{{question.chapter}} {{question.multiple ? '· 多选' : question.type === 'choice' ? '· 单选' : '· 主观题'}}</view>
    <view class="stem"><question-content question-id="{{question.id}}" kind="question" text="{{question.stem}}" /></view>

    <view wx:if="{{question.type === 'choice'}}">
      <view wx:for="{{question.options}}" wx:key="key" class="option {{item.selected ? 'selected' : ''}}" hover-class="tap-pressed" hover-stay-time="90" data-key="{{item.key}}" bindtap="choose">
        <text class="option-key">{{item.key}}</text><text class="option-text" user-select="true">{{item.text}}</text>
      </view>
    </view>
    <view wx:else>
      <textarea wx:if="{{!result}}" class="draft-input" placeholder="输入作答内容" value="{{draft}}" bindinput="inputDraft" bindblur="editDraft" bindkeyboardheightchange="keyboardChanged" cursor-spacing="100" auto-height="true" maxlength="-1" />
      <view wx:if="{{result && draft}}" class="draft-preview"><view class="muted">我的作答</view><text user-select="true">{{draft}}</text></view>
    </view>

    <view wx:if="{{result}}" class="answer-box">
      <view class="answer-status">{{result.subjective ? '参考答案' : result.correct ? '回答正确' : '回答错误'}}</view>
      <view wx:if="{{!result.subjective}}" class="muted">正确选项 {{result.expected}}</view>
      <view class="answer-text"><question-content question-id="{{question.id}}" kind="analysis" text="{{result.answer + '\n' + result.analysis}}" /></view>
      <view wx:if="{{result.subjective && !result.graded}}" class="grade-row">
        <button class="button button-light" data-correct="false" bindtap="grade">需复习</button>
        <button class="button button-yellow" data-correct="true" bindtap="grade">已掌握</button>
      </view>
      <view wx:if="{{result.subjective && result.graded}}" class="muted">{{result.correct ? '已掌握' : '已加入错题'}}</view>
    </view>

    <view class="question-tools"><button class="button button-light" bindtap="toggleMark">{{marked ? '★ 已标记' : '☆ 标记此题'}}</button></view>
    <view class="answer-dock" style="bottom:{{keyboardHeight}}px">
      <button class="button button-light" bindtap="toggleSheet">答题卡</button>
      <button class="button button-light" disabled="{{index === 0}}" bindtap="previous">上一题</button>
      <button wx:if="{{!result && question.type === 'choice'}}" class="button button-yellow" bindtap="submit">提交</button>
      <button wx:elif="{{!result}}" class="button button-yellow" bindtap="reveal">看参考解</button>
      <button class="button" bindtap="next">{{index + 1 === total ? '完成' : result ? '下一题' : '跳过'}}</button>
    </view>
  </view>

  <view wx:if="{{done}}" class="summary">
    <view class="heading">练习结果</view>
    <view class="summary-count">{{answeredCount}} <text>/ {{total}} 题已作答</text></view>
    <view class="summary-row"><text>正确 {{correctCount}}</text><text>错误 {{wrongCount}}</text><text>未作答 {{total - answeredCount}}</text></view>
    <button wx:if="{{retryCount}}" class="button button-yellow" bindtap="retry">重练错题与未完成题（{{retryCount}}）</button>
    <button class="button" bindtap="backHome">返回</button>
  </view>
</view>
